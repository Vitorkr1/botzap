# Chave gratuita da Groq (https://console.groq.com/keys) — não precisa de cartão
GROQ_API_KEY=gsk_xxxxxxxx

# Modelo usado (opcional, padrão llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Instrução de sistema do agente (opcional — já vem configurado com os dados
# da Cria Tech direto em lib/ai.js; só use esta variável se quiser
# sobrescrever tudo por aqui)
# SYSTEM_PROMPT="..."

# Responder também em grupos? (padrão: false)
RESPOND_TO_GROUPS=false

# Números que NUNCA devem receber resposta automática, além dos que já
# estão salvos na sua agenda (reforço, útil logo nos primeiros segundos
# após conectar, antes da agenda terminar de sincronizar). Separe por vírgula,
# só números com DDI e DDD, sem "+" e sem espaços. Ex: 5581999999999,5581888888888
NEVER_AUTO_REPLY_NUMBERS=

# Tempo (em milissegundos) que o bot fica em silêncio logo após conectar,
# esperando a sincronização da agenda terminar antes de responder qualquer
# mensagem. Padrão: 60000 (60 segundos). Se você tem muitos contatos e ainda
# assim ver o bot responder alguém salvo, aumente esse valor (ex: 120000).
CONTACTS_SYNC_GRACE_MS=60000

# Configurações do comando /followup (busca clientes sem resposta sobre
# site/sistema e manda mensagem automática de follow-up — nunca repete pro
# mesmo número, mesmo rodando o comando várias vezes):
# Máximo de mensagens de follow-up enviadas por execução (segurança)
FOLLOWUP_MAX_PER_RUN=15
# Tempo simulado de "digitando..." antes de cada envio (min/max, em ms)
FOLLOWUP_TYPING_MIN_MS=2000
FOLLOWUP_TYPING_MAX_MS=6000
# Intervalo (ms) entre cada envio de follow-up, pra não parecer spam
FOLLOWUP_DELAY_MS=8000
# Intervalo mínimo (horas) entre execuções que mandam mensagem de verdade —
# força "um dia sim, um dia não" mesmo se você tentar rodar /followup todo
# dia. Padrão: 36h (garante pular pelo menos um dia).
FOLLOWUP_RUN_COOLDOWN_HOURS=36

# Alerta externo (fora do WhatsApp) quando o bot desconectar ou precisar de
# um QR code novo. Gratuito, sem conta: baixe o app "ntfy" (Android/iOS) ou
# acesse ntfy.sh, escolha um nome de tópico único e difícil de adivinhar
# (ex: criatech-bot-x7k2), se inscreva nele no app, e coloque o mesmo nome
# aqui. Deixe em branco pra desativar os alertas.
NTFY_TOPIC=
# Intervalo mínimo (minutos) entre alertas repetidos de desconexão
ALERT_COOLDOWN_MINUTES=15

# Pasta onde ficam salvos a sessão do WhatsApp e os dados de contatos
# Em produção (Render) isso deve apontar para um Persistent Disk
AUTH_DIR=./auth
DATA_DIR=./data

PORT=3000
